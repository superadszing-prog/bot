# =============================================================================
# AI Bot API Server - Environment Configuration
# Copy this file to .env and fill in your values:  cp .env.example .env
# =============================================================================

# --- Server ---
NODE_ENV=development
PORT=3000
# Public base URL of this server (used in webhook payloads / docs)
BASE_URL=http://localhost:3000

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017/ai_bot

# --- Redis (queue + cache). Leave empty to use the in-memory fallback queue. ---
REDIS_URL=redis://localhost:6379

# --- Authentication ---
# Secret used to sign JWT tokens. CHANGE THIS IN PRODUCTION.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Bcrypt salt rounds for hashing API keys
BCRYPT_SALT_ROUNDS=10

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
# Stricter limit for command execution endpoints
RATE_LIMIT_COMMANDS_MAX=20

# --- CORS (comma separated list of allowed origins, or * for all) ---
CORS_ORIGINS=*

# --- File uploads / storage ---
# STORAGE_DRIVER=local | s3
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
# Max upload size in megabytes
MAX_UPLOAD_SIZE_MB=500

# --- AWS S3 (only used when STORAGE_DRIVER=s3) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=

# --- Webhooks ---
# Secret used to sign webhook payloads (X-Webhook-Signature header)
WEBHOOK_SECRET=change-me-webhook-secret
# Delivery attempts before giving up
WEBHOOK_MAX_RETRIES=5
# Request timeout for a single webhook delivery (ms)
WEBHOOK_TIMEOUT_MS=10000

# --- Video processing simulation ---
# Set to "false" to run real processing workers only
SIMULATE_PROCESSING=true

# --- Logging ---
LOG_LEVEL=info
