# Copy this file to `.env` for local development/build scripts.
# The extension itself stores the API key in chrome.storage.local via the
# popup UI (Permissions panel), NOT via this file — this .env is only used
# by optional Node.js tooling (tests/build scripts) in this repository.

# OpenAI API key used when running scripts/tests that call the Vision API.
OPENAI_API_KEY=sk-your-api-key-here

# Optional: override the default OpenAI endpoint (e.g. for a proxy).
OPENAI_API_ENDPOINT=https://api.openai.com/v1/chat/completions

# Optional: override the default vision model.
OPENAI_MODEL=gpt-4o-mini
